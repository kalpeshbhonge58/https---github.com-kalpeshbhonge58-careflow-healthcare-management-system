{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CareFlowDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "CareFlow",
    "Audience": "CareFlowUsers",
    "ExpirationMinutes": 60
  },
  "ResendSettings": {
    "ApiKey": "",
    "FromEmail": "notifications@careflow.local",
    "ApiUrl": "https://api.resend.com/emails",
    "TimeoutSeconds": 30,
    "UseMockFallback": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:5001" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
