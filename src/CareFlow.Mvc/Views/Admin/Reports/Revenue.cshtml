@model CareFlow.Mvc.ViewModels.Reports.RevenueReportViewModel
@using CareFlow.Mvc.ViewModels.Reports
@{
    ViewData["Title"] = "Revenue Report";
    var apiConfig = ViewBag.ApiConfig as ReportsPageViewModel ?? new ReportsPageViewModel();
}

<div id="reports-config"
     data-api-base-url="@apiConfig.ApiBaseUrl"
     data-api-token="@apiConfig.ApiToken"
     data-report-type="revenue">
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Revenue Report</h1>
        <p class="text-muted mb-0">Invoice and payment data from the Web API</p>
    </div>
</div>

@await Html.PartialAsync("_ReportFilters", new ReportFilterViewModel
{
    FilterType = "revenue",
    SelectedPaymentStatus = Model.SelectedPaymentStatus
})

<div id="report-alert" class="alert alert-danger d-none" role="alert"></div>

<div class="row g-3 mb-4">
    @await Html.PartialAsync("_ReportStatCard", ("Total Revenue", Model.TotalRevenue.ToString("C"), "bi-graph-up", "success"))
    @await Html.PartialAsync("_ReportStatCard", ("Pending Amount", Model.PendingAmount.ToString("C"), "bi-clock-history", "warning"))
    @await Html.PartialAsync("_ReportStatCard", ("Invoice Count", Model.Invoices.Count.ToString("N0"), "bi-receipt", "info"))
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Invoices</h5>
        <span class="badge bg-secondary" id="refresh-indicator">Ready</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="revenue-table">
                <thead class="table-light">
                    <tr>
                        <th>Invoice #</th>
                        <th>Patient</th>
                        <th>Date</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">Tax</th>
                        <th class="text-end">Discount</th>
                        <th class="text-end">Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Model.Invoices)
                    {
                        <tr>
                            <td>@invoice.InvoiceNumber</td>
                            <td>@invoice.PatientName</td>
                            <td>@invoice.InvoiceDate.ToString("d")</td>
                            <td class="text-end">@invoice.SubTotal.ToString("C")</td>
                            <td class="text-end">@invoice.TaxAmount.ToString("C")</td>
                            <td class="text-end">@invoice.DiscountAmount.ToString("C")</td>
                            <td class="text-end">@invoice.TotalAmount.ToString("C")</td>
                            <td><span class="badge bg-secondary">@invoice.PaymentStatus</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
