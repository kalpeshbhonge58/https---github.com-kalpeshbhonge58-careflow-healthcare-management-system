@model CareFlow.Mvc.ViewModels.Reports.DashboardOverviewViewModel
@using CareFlow.Mvc.ViewModels.Reports
@{
    ViewData["Title"] = "Reports Overview";
    var apiConfig = ViewBag.ApiConfig as ReportsPageViewModel ?? new ReportsPageViewModel();
}

<div id="reports-config"
     data-api-base-url="@apiConfig.ApiBaseUrl"
     data-api-token="@apiConfig.ApiToken"
     data-report-type="dashboard">
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Admin Reports Overview</h1>
        <p class="text-muted mb-0">Live metrics from the CareFlow Web API</p>
    </div>
    <span class="badge bg-primary" id="refresh-indicator">Ready</span>
</div>

<div id="report-alert" class="alert alert-danger d-none" role="alert"></div>

@await Html.PartialAsync("_ReportFilters", new ReportFilterViewModel { FilterType = "dashboard" })

<div class="row g-3 mb-4" id="dashboard-stats">
    @await Html.PartialAsync("_ReportStatCard", ("Total Patients", Model.TotalPatients.ToString("N0"), "bi-people", "primary"))
    @await Html.PartialAsync("_ReportStatCard", ("Total Doctors", Model.TotalDoctors.ToString("N0"), "bi-heart-pulse", "success"))
    @await Html.PartialAsync("_ReportStatCard", ("Today's Appointments", Model.TodayAppointments.ToString("N0"), "bi-calendar-check", "info"))
    @await Html.PartialAsync("_ReportStatCard", ("Pending Confirmations", Model.PendingConfirmations.ToString("N0"), "bi-hourglass-split", "warning"))
    @await Html.PartialAsync("_ReportStatCard", ("Monthly Revenue", Model.MonthlyRevenue.ToString("C"), "bi-currency-dollar", "success"))
    @await Html.PartialAsync("_ReportStatCard", ("Pending Payments", Model.PendingPayments.ToString("C"), "bi-exclamation-circle", "danger"))
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">Appointments by Department</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped mb-0" id="dept-table">
                        <thead class="table-light">
                            <tr>
                                <th>Department</th>
                                <th class="text-end">Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model.AppointmentsByDepartment)
                            {
                                <tr>
                                    <td>@dept.Department</td>
                                    <td class="text-end">@dept.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="card-title mb-0">Appointments by Doctor</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped mb-0" id="doctor-table">
                        <thead class="table-light">
                            <tr>
                                <th>Doctor</th>
                                <th class="text-end">Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model.AppointmentsByDoctor)
                            {
                                <tr>
                                    <td>@doc.DoctorName</td>
                                    <td class="text-end">@doc.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
