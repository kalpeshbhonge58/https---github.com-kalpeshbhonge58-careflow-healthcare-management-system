@model CareFlow.Mvc.ViewModels.Reports.ReportFilterViewModel

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form id="report-filters" class="row g-3 align-items-end">
            @if (Model.FilterType == "revenue")
            {
                <div class="col-md-4">
                    <label for="paymentStatus" class="form-label">Payment Status</label>
                    <select id="paymentStatus" name="paymentStatus" class="form-select">
                        <option value="">All</option>
                        <option value="Pending" selected="@(Model.SelectedPaymentStatus == "Pending")">Pending</option>
                        <option value="PartiallyPaid" selected="@(Model.SelectedPaymentStatus == "PartiallyPaid")">Partially Paid</option>
                        <option value="Paid" selected="@(Model.SelectedPaymentStatus == "Paid")">Paid</option>
                        <option value="Cancelled" selected="@(Model.SelectedPaymentStatus == "Cancelled")">Cancelled</option>
                    </select>
                </div>
            }
            else if (Model.FilterType == "appointments")
            {
                <div class="col-md-4">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">All</option>
                        <option value="Scheduled" selected="@(Model.SelectedStatus == "Scheduled")">Scheduled</option>
                        <option value="Confirmed" selected="@(Model.SelectedStatus == "Confirmed")">Confirmed</option>
                        <option value="Completed" selected="@(Model.SelectedStatus == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(Model.SelectedStatus == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="doctorId" class="form-label">Doctor ID</label>
                    <input type="number" id="doctorId" name="doctorId" class="form-control"
                           value="@Model.SelectedDoctorId" placeholder="Optional" min="1" />
                </div>
            }
            else
            {
                <div class="col-md-4">
                    <p class="text-muted mb-0">Dashboard refreshes automatically from the API.</p>
                </div>
            }
            <div class="col-md-4">
                <button type="button" id="btn-refresh-report" class="btn btn-primary">
                    <i class="bi bi-arrow-clockwise"></i> Refresh Data
                </button>
            </div>
        </form>
    </div>
</div>
